<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">
  <application>
    <meta-data android:name="firebase_messaging_auto_init_enabled" android:value="false" />
    <meta-data android:name="firebase_messaging_notification_delegation_enabled" android:value="false" />
    <provider
      android:name="com.onekey.jpush.fcm.FcmInitProvider"
      android:authorities="${applicationId}.onekey.fcm.init"
      android:exported="false" />
    <service
      android:name="com.google.firebase.messaging.FirebaseMessagingService"
      tools:node="remove" />
    <service android:name="com.onekey.jpush.fcm.FcmMessagingService" android:exported="false">
      <intent-filter>
        <action android:name="com.google.firebase.MESSAGING_EVENT" />
      </intent-filter>
    </service>
    <activity android:name="cn.jpush.android.service.JNotifyActivity" android:exported="false">
      <intent-filter>
        <action android:name="cn.jpush.android.intent.NOTIFICATION_OPENED" />
        <category android:name="android.intent.category.DEFAULT" />
      </intent-filter>
    </activity>
  </application>
</manifest>
