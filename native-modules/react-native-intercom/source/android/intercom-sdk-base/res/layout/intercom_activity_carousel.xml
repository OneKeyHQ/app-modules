<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/intercom_carousel_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/intercom_white">


    <androidx.viewpager.widget.ViewPager
        android:id="@+id/intercom_view_pager"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/intercom_page_navigation_layout"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <FrameLayout
        android:id="@+id/intercom_state_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/intercom_white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/intercom_carousel_close_container" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/intercom_carousel_close_container"
        android:layout_width="@dimen/intercom_carousel_close_container"
        android:layout_height="@dimen/intercom_carousel_close_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <View
            android:id="@+id/intercom_close_background"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:alpha="0.15"
            android:background="@drawable/intercom_transparent_dark_circle"
            app:layout_constraintBottom_toBottomOf="@+id/intercom_close"
            app:layout_constraintStart_toStartOf="@+id/intercom_close"
            app:layout_constraintEnd_toEndOf="@+id/intercom_close"
            app:layout_constraintTop_toTopOf="@+id/intercom_close" />

        <ImageButton
            android:id="@+id/intercom_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.8"
            android:background="@color/intercom_full_transparent_full_black"
            android:clickable="true"
            android:focusable="true"
            android:src="@drawable/intercom_close_round"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:contentDescription="Close" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
