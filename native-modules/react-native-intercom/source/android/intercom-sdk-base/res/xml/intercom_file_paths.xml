<?xml version="1.0" encoding="utf-8"?>
<!-- Each media type declares both cache-path (internal) and external-cache-path,
     as a fallback when external storage is unavailable. -->
<paths>
    <!-- Images (push notifications, photos from camera) -->
    <cache-path
        name="shared_images_internal"
        path="images/" />
    <external-cache-path
        name="shared_images_external"
        path="images/" />

    <!-- Videos from camera -->
    <cache-path
        name="shared_videos_internal"
        path="videos/" />
    <external-cache-path
        name="shared_videos_external"
        path="videos/" />

    <!-- Audio recordings for voice notes -->
    <cache-path
        name="shared_audio_internal"
        path="audio_recordings/" />
    <external-cache-path
        name="shared_audio_external"
        path="audio_recordings/" />
</paths>
