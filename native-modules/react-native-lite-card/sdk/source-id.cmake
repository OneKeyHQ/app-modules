# Match scripts/generate-source-id.rb using only fixed relative paths and file content.
get_filename_component(GPCHANNEL_PACKAGE_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(GPCHANNEL_SOURCE_MANIFEST "${CMAKE_CURRENT_LIST_DIR}/source-id-manifest.txt")
file(STRINGS "${GPCHANNEL_SOURCE_MANIFEST}" GPCHANNEL_SOURCE_ENTRIES)
set(GPCHANNEL_SOURCE_PATHS)
foreach(entry IN LISTS GPCHANNEL_SOURCE_ENTRIES)
  if(entry MATCHES "/$")
    file(GLOB_RECURSE contents CONFIGURE_DEPENDS LIST_DIRECTORIES false
      RELATIVE "${GPCHANNEL_PACKAGE_ROOT}" "${GPCHANNEL_PACKAGE_ROOT}/${entry}*")
    list(FILTER contents INCLUDE REGEX "\\.(c|cpp|h|hpp|inc|table|m|mm|swift|kt|java)$")
    list(FILTER contents EXCLUDE REGEX "(^|/)(\\.[^/]*|build|generated|CMakeFiles|node_modules|__pycache__)(/|$)")
    list(APPEND GPCHANNEL_SOURCE_PATHS ${contents})
  else()
    list(APPEND GPCHANNEL_SOURCE_PATHS "${entry}")
  endif()
endforeach()
list(REMOVE_DUPLICATES GPCHANNEL_SOURCE_PATHS)
list(SORT GPCHANNEL_SOURCE_PATHS)
set(GPCHANNEL_SOURCE_CONTENT "")
foreach(path IN LISTS GPCHANNEL_SOURCE_PATHS)
  file(SHA256 "${GPCHANNEL_PACKAGE_ROOT}/${path}" digest)
  string(APPEND GPCHANNEL_SOURCE_CONTENT "${path} ${digest}\n")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${GPCHANNEL_PACKAGE_ROOT}/${path}")
endforeach()
string(SHA256 GPCHANNEL_SOURCE_DIGEST "${GPCHANNEL_SOURCE_CONTENT}")
set(GPCHANNEL_GENERATED_INCLUDE "${CMAKE_CURRENT_BINARY_DIR}/generated")
file(MAKE_DIRECTORY "${GPCHANNEL_GENERATED_INCLUDE}")
file(WRITE "${GPCHANNEL_GENERATED_INCLUDE}/GPChannelSourceId.h.in"
  "#define GPCHANNEL_NATIVE_SOURCE_ID \"source-v1:${GPCHANNEL_SOURCE_DIGEST}\"\n")
configure_file("${GPCHANNEL_GENERATED_INCLUDE}/GPChannelSourceId.h.in"
  "${GPCHANNEL_GENERATED_INCLUDE}/GPChannelSourceId.h" COPYONLY)
