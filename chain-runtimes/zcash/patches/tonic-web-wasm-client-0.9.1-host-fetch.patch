@@ -23,8 +23,13 @@ fn js_fetch(request: &Request, init: &RequestInit) -> Promise {
     }
 }
 
-pub async fn fetch(request: &Request, init: &RequestInit) -> Result<Response, Error> {
-    let js_response = JsFuture::from(js_fetch(request, init))
+pub async fn fetch(request: &Request, init: &RequestInit, handler: Option<&js_sys::Function>) -> Result<Response, Error> {
+    // OneKey patch: keep the upstream response/trailer parser and abort guard.
+    let promise = match handler {
+        Some(handler) => Promise::resolve(&handler.call2(&JsValue::NULL, request, init).map_err(Error::js_error)?),
+        None => js_fetch(request, init),
+    };
+    let js_response = JsFuture::from(promise)
         .await
         .map_err(Error::js_error)?;
 
