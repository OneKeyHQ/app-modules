+/// OneKey: [`VIEW_ORCHARD_SHARDS_SCAN_STATE`] and its siblings, except that an unscanned range
+/// below the scan floor no longer marks its shard unscanned: it waits for a paused account.
+fn onekey_view_shards_scan_state(pool: &str) -> String {
+    format!(
+        "CREATE VIEW v_{pool}_shards_scan_state AS
+SELECT
+    shard_index,
+    start_position,
+    end_position_exclusive,
+    subtree_start_height,
+    subtree_end_height,
+    contains_marked,
+    MAX(priority) AS max_priority
+FROM v_{pool}_shard_scan_ranges
+WHERE NOT (priority > {} AND block_range_end <= IFNULL(({}), 0))
+GROUP BY
+    shard_index,
+    start_position,
+    end_position_exclusive,
+    subtree_start_height,
+    subtree_end_height,
+    contains_marked",
+        priority_code(&ScanPriority::Scanned),
+        ONEKEY_SCAN_FLOOR_SQL,
+    )
+}
+
+/// OneKey: recreates the shard views whose definitions predate the scan floor, so existing
+/// databases follow [`ONEKEY_SCAN_FLOOR_SQL`]. Returns whether anything was recreated.
+pub(crate) fn rebuild_onekey_shard_views(conn: &mut rusqlite::Connection) -> Result<bool, rusqlite::Error> {
+    let views = [
+        ("v_sapling_shard_unscanned_ranges", view_sapling_shard_unscanned_ranges()),
+        ("v_sapling_shards_scan_state", onekey_view_shards_scan_state("sapling")),
+        ("v_orchard_shard_unscanned_ranges", view_orchard_shard_unscanned_ranges()),
+        ("v_orchard_shards_scan_state", onekey_view_shards_scan_state("orchard")),
+        ("v_ironwood_shard_unscanned_ranges", view_ironwood_shard_unscanned_ranges()),
+        ("v_ironwood_shards_scan_state", onekey_view_shards_scan_state("ironwood")),
+    ];
+    let mut stale = Vec::new();
+    for (name, sql) in &views {
+        let current: Option<String> = conn
+            .query_row(
+                "SELECT sql FROM sqlite_master WHERE type = 'view' AND name = ?1",
+                [name],
+                |row| row.get(0),
+            )
+            .optional()?;
+        if current.as_deref() != Some(sql.as_str()) {
+            stale.push((name, sql));
+        }
+    }
+    if stale.is_empty() {
+        return Ok(false);
+    }
+    // Views resolve their dependencies when queried, so each can be replaced on its own.
+    let tx = conn.transaction()?;
+    for (name, sql) in stale {
+        tx.execute_batch(&format!("DROP VIEW IF EXISTS {name}; {sql};"))?;
+    }
+    tx.commit()?;
+    Ok(true)
+}
