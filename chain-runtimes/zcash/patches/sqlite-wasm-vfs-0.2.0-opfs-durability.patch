+// Browser SAHs exclude other Workers; these locks coordinate SQLite connections
+// inside this Worker. Keep the state machine independent of browser APIs.
+mod file_locks {
+    use std::collections::HashMap;
+
+    #[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord)]
+    pub(super) enum Lock {
+        None,
+        Shared,
+        Reserved,
+        Pending,
+        Exclusive,
+    }
+
+    #[derive(Default)]
+    pub(super) struct FileLocks {
+        files: HashMap<usize, (String, Lock)>,
+    }
+
+    impl FileLocks {
+        pub(super) fn open(&mut self, id: usize, filename: &str) {
+            self.files.insert(id, (filename.into(), Lock::None));
+        }
+
+        pub(super) fn close(&mut self, id: usize) {
+            self.files.remove(&id);
+        }
+
+        pub(super) fn is_empty(&self) -> bool {
+            self.files.is_empty()
+        }
+
+        pub(super) fn lock(&mut self, id: usize, requested: Lock) -> bool {
+            let Some((filename, current)) = self.files.get(&id) else {
+                return false;
+            };
+            if *current >= requested {
+                return true;
+            }
+            let other = self
+                .files
+                .iter()
+                .filter(|(other_id, (name, _))| **other_id != id && name == filename)
+                .map(|(_, (_, lock))| *lock)
+                .max()
+                .unwrap_or(Lock::None);
+            let allowed = match requested {
+                Lock::None => true,
+                Lock::Shared => other < Lock::Pending,
+                Lock::Reserved | Lock::Pending | Lock::Exclusive => {
+                    *current >= Lock::Shared && other < Lock::Reserved
+                }
+            };
+            if !allowed {
+                return false;
+            }
+            let (_, current) = self.files.get_mut(&id).unwrap();
+            if requested == Lock::Exclusive && other >= Lock::Shared {
+                // Block new readers while existing readers finish, then retry.
+                *current = Lock::Pending;
+                return false;
+            }
+            *current = requested;
+            true
+        }
+
+        pub(super) fn unlock(&mut self, id: usize, requested: Lock) -> bool {
+            let Some((_, current)) = self.files.get_mut(&id) else {
+                return false;
+            };
+            if !matches!(requested, Lock::None | Lock::Shared) || requested > *current {
+                return false;
+            }
+            *current = requested;
+            true
+        }
+
+        pub(super) fn reserved(&self, id: usize) -> Option<bool> {
+            let (filename, _) = self.files.get(&id)?;
+            Some(
+                self.files
+                    .values()
+                    .any(|(name, lock)| name == filename && *lock >= Lock::Reserved),
+            )
+        }
+    }
+
+    #[cfg(test)]
+    mod tests {
+        use super::{FileLocks, Lock};
+
+        fn connections() -> FileLocks {
+            let mut locks = FileLocks::default();
+            for id in 1..=3 {
+                locks.open(id, "wallet.db");
+            }
+            locks
+        }
+
+        #[test]
+        fn readers_coexist_and_only_one_writer_reserves() {
+            let mut locks = connections();
+            assert!(locks.lock(1, Lock::Shared));
+            assert!(locks.lock(2, Lock::Shared));
+            assert!(locks.lock(1, Lock::Reserved));
+            assert!(!locks.lock(2, Lock::Reserved));
+            assert!(locks.lock(3, Lock::Shared));
+            assert_eq!(locks.reserved(2), Some(true));
+        }
+
+        #[test]
+        fn exclusive_retry_holds_pending_and_blocks_new_readers() {
+            let mut locks = connections();
+            assert!(locks.lock(1, Lock::Shared));
+            assert!(locks.lock(2, Lock::Shared));
+            assert!(!locks.lock(1, Lock::Exclusive));
+            assert_eq!(locks.files[&1].1, Lock::Pending);
+            assert!(!locks.lock(3, Lock::Shared));
+            assert!(!locks.lock(2, Lock::Reserved));
+            assert!(locks.unlock(2, Lock::None));
+            assert!(locks.lock(1, Lock::Exclusive));
+            assert!(!locks.lock(3, Lock::Shared));
+            assert!(locks.unlock(1, Lock::Shared));
+            assert_eq!(locks.reserved(1), Some(false));
+            assert!(locks.lock(3, Lock::Shared));
+        }
+
+        #[test]
+        fn reserved_conflict_does_not_acquire_pending() {
+            let mut locks = connections();
+            assert!(locks.lock(1, Lock::Shared));
+            assert!(locks.lock(1, Lock::Reserved));
+            assert!(locks.lock(2, Lock::Shared));
+            assert!(!locks.lock(2, Lock::Exclusive));
+            assert_eq!(locks.files[&2].1, Lock::Shared);
+        }
+
+        #[test]
+        fn closing_one_connection_preserves_other_connections_and_locks() {
+            let mut locks = connections();
+            assert!(locks.lock(1, Lock::Shared));
+            assert!(locks.lock(1, Lock::Reserved));
+            locks.close(2);
+            assert!(!locks.is_empty());
+            assert_eq!(locks.reserved(3), Some(true));
+            locks.close(1);
+            assert_eq!(locks.reserved(3), Some(false));
+            locks.close(3);
+            assert!(locks.is_empty());
+        }
+
+        #[test]
+        fn hot_journal_recovery_and_independent_databases() {
+            let mut locks = connections();
+            assert_eq!(locks.reserved(1), Some(false));
+            assert!(locks.lock(1, Lock::Shared));
+            assert!(locks.lock(1, Lock::Exclusive));
+            locks.open(4, "other.db");
+            assert_eq!(locks.reserved(4), Some(false));
+            assert!(locks.lock(4, Lock::Shared));
+            assert!(locks.lock(4, Lock::Exclusive));
+            assert!(locks.unlock(1, Lock::None));
+            assert_eq!(locks.reserved(2), Some(false));
+        }
+    }
+}
