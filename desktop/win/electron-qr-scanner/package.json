{
  "name": "@onekeyfe/electron-qr-scanner",
  "version": "0.1.0",
  "private": true,
  "description": "Windows camera QR capture, shared-texture preview and image decoding for Electron (Media Foundation + D3D11 + ZXing-C++)",
  "main": "index.cjs",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.cjs",
    "index.d.ts",
    "electron-qr-scanner.win32-x64-msvc.node",
    "electron-qr-scanner.win32-arm64-msvc.node"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.cjs",
    "test:types": "tsc --noEmit --strict --skipLibCheck --module node16 --moduleResolution node16 test/types.ts",
    "test:electron": "electron test/electron.cjs",
    "test:preview": "electron test/preview.cjs",
    "test:camera": "electron test/camera-live.cjs",
    "prepack": "node scripts/check-package.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OneKeyHQ/app-modules.git",
    "directory": "desktop/win/electron-qr-scanner"
  },
  "license": "MIT",
  "os": [
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "devDependencies": {
    "@ngraveio/bc-ur": "1.1.13",
    "@types/node": "^22.0.0",
    "electron": "44.9.3",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
