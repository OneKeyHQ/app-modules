{
  "name": "@onekeyfe/react-native-native-list",
  "version": "3.0.101",
  "description": "Template-driven native RecyclerView and UICollectionView for React Native",
  "source": "./src/index.ts",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "common",
    "cpp",
    "nitrogen",
    "nitro.json",
    "docs",
    "react-native.config.js",
    "*.podspec",
    "!ios/build",
    "!android/build",
    "!android/app/build",
    "!**/__tests__",
    "!**/*.map"
  ],
  "scripts": {
    "clean": "del-cli lib",
    "prepare": "del-cli lib && bob build && cp -r nitrogen lib/nitrogen",
    "nitrogen": "nitrogen",
    "typecheck": "tsc -b",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "test": "jest --runInBand",
    "release": "yarn prepare && npm whoami && npm publish --access public"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "recyclerview",
    "uicollectionview"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OneKeyHQ/app-modules.git",
    "directory": "native-views/react-native-native-list"
  },
  "author": "OneKey",
  "homepage": "https://github.com/OneKeyHQ/app-modules",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "devDependencies": {
    "@eslint/compat": "^1.3.2",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.35.0",
    "@react-native/babel-preset": "0.86.2",
    "@react-native/eslint-config": "0.86.2",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.0",
    "del-cli": "^6.0.0",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^29.7.0",
    "nitrogen": "0.37.0",
    "prettier": "^2.8.8",
    "react": "19.2.3",
    "react-native": "patch:react-native@npm%3A0.86.2#~/.yarn/patches/react-native-npm-0.86.2-c9d546616f.patch",
    "react-native-builder-bob": "^0.40.13",
    "react-native-nitro-modules": "0.37.0",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "@onekeyfe/react-native-image": "3.0.101",
    "react": "*",
    "react-native": "*",
    "react-native-nitro-modules": "0.37.0"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "custom",
        {
          "script": "nitrogen",
          "clean": "nitrogen/"
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "jest": {
    "preset": "react-native",
    "modulePathIgnorePatterns": [
      "<rootDir>/lib/"
    ]
  },
  "prettier": {
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5"
  }
}
