{
  "name": "@onekeyfe/react-native-image",
  "version": "6.7.0-23",
  "description": "High-performance native image view for OneKey",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json",
    "./icon": {
      "browser": {
        "source": "./src/icon/index.web.tsx",
        "types": "./lib/typescript/src/icon/index.d.ts",
        "default": "./lib/module/icon/index.web.js"
      },
      "react-native": {
        "source": "./src/icon/index.tsx",
        "types": "./lib/typescript/src/icon/index.d.ts",
        "default": "./lib/module/icon/index.js"
      },
      "types": "./lib/typescript/src/icon/index.d.ts",
      "source": "./src/icon/index.tsx",
      "default": "./lib/module/icon/index.js"
    },
    "./icon/dom": {
      "source": "./src/icon/dom.ts",
      "types": "./lib/typescript/src/icon/dom.d.ts",
      "default": "./lib/module/icon/dom.js"
    }
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "nitrogen",
    "nitro.json",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/.*",
    "!**/*.map",
    "scripts"
  ],
  "scripts": {
    "clean": "del-cli android/build lib",
    "prepare": "rm -rf lib && bob build && cp -r nitrogen lib/nitrogen && node scripts/configure-icon-imports.mjs",
    "nitrogen": "nitrogen",
    "typecheck": "tsc",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "test": "jest",
    "release": "yarn nitrogen && yarn prepare && npm whoami && npm publish --access public",
    "icons:check": "node scripts/icon-fixtures.test.mjs",
    "icons:test": "node scripts/icon-fixtures.test.mjs"
  },
  "keywords": [
    "react-native",
    "image",
    "ios",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OneKeyHQ/app-modules.git",
    "directory": "native-views/react-native-image"
  },
  "author": "@onekeyfe <huanming@onekey.so>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/OneKeyHQ/app-modules/issues"
  },
  "homepage": "https://github.com/OneKeyHQ/app-modules/tree/main/native-views/react-native-image#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@eslint/compat": "^1.3.2",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.35.0",
    "@react-native/babel-preset": "0.88.0",
    "@react-native/eslint-config": "0.88.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.3.0",
    "@types/react-test-renderer": "^19.1.0",
    "del-cli": "^6.0.0",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^29.7.0",
    "nitrogen": "0.37.0",
    "prettier": "^2.8.8",
    "react": "19.3.0",
    "react-native": "patch:react-native@npm%3A0.88.0#~/.yarn/patches/react-native-npm-0.88.0-60c6201dd2.patch",
    "react-native-builder-bob": "^0.40.13",
    "react-native-nitro-modules": "0.37.0",
    "react-test-renderer": "19.3.0",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "@onekeyfe/react-native-skeleton": "6.7.0-23",
    "react": "*",
    "react-native": "*",
    "react-native-nitro-modules": "0.37.0"
  },
  "packageManager": "yarn@4.1.0",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "custom",
        {
          "script": "nitrogen",
          "clean": "nitrogen/"
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "modulePathIgnorePatterns": [
      "<rootDir>/lib/"
    ],
    "moduleNameMapper": {
      "^#onekey-icon-assets$": "<rootDir>/../react-native-image/src/icon/assetUrls.ts"
    }
  },
  "imports": {
    "#onekey-icon-assets": {
      "types": "./src/icon/assetUrls.ts",
      "source": "./src/icon/assetUrls.ts",
      "default": "./lib/module/icon/assetUrls.js"
    }
  }
}
